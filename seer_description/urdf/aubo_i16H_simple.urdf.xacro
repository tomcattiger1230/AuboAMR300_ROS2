<?xml version="1.0"?>
<robot name="aubo_i16H_simple" xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Simplified collision model for Gazebo simulation.
    Visual meshes kept intact for RViz display.
    Collision geometries replaced with primitive shapes (cylinders/spheres)
    for faster physics computation.
  -->
  <dh_type type="modified" />
  <safety_para singularity_consistent="0.02 0.01 10 0.2 0.045 10" />

  <!--
    Collision primitives guide for i16H:
    - link0 (base):        cylinder r=0.06 h=0.163
    - link1 (shoulder):    sphere r=0.08
    - link2 (upperArm):    cylinder r=0.045 h=0.480
    - link3 (foreArm):     cylinder r=0.035 h=0.370
    - link4 (wrist1):     sphere r=0.045
    - link5 (wrist2):     sphere r=0.045
    - link6 (wrist3/TCP): sphere r=0.035
  -->

  <link name="aubo_base_link">
    <inertial>
      <origin xyz="0.000136 0.001601 0.018986" rpy="0 0 0" />
      <mass value="2.592000" />
      <inertia ixx="0.008524" ixy="-0.000001" ixz="-0.000005" iyy="0.007934" iyz="-0.000081"
        izz="0.015304" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link0.DAE" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <!-- Base: small cylinder -->
    <collision>
      <origin xyz="0 0 0.0815" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.163" />
      </geometry>
    </collision>
  </link>

  <link name="shoulder_Link">
    <inertial>
      <origin xyz="-0.000004 0.005112 -0.026275" rpy="0 0 0" />
      <mass value="10.180139" />
      <inertia ixx="0.043326" ixy="0.000003" ixz="0.000003" iyy="0.042233" iyz="-0.001767"
        izz="0.029902" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link1.DAE" />
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <!-- Shoulder: sphere approximation for boxy shape -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <origin xyz="0 0 0.163" rpy="-8.7138E-17 -4.3534E-32 3.1415926535897932384626433832795" />
    <parent link="aubo_base_link" />
    <child link="shoulder_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="267" start_stop="411"
      velocity="3.106686068549906" />
  </joint>

  <link name="upperArm_Link">
    <inertial>
      <origin xyz="0.170602 0.000000 -0.013024" rpy="0 0 0" />
      <mass value="17.664060" />
      <inertia ixx="0.063521" ixy="0.000020" ixz="-0.024888" iyy="0.847528" iyz="0.000005"
        izz="0.828847" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link2.DAE" />
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <!-- Upper arm: long cylinder along the link -->
    <collision>
      <origin xyz="0.26 0 0" rpy="0 1.5707963267948966192313216916398 0" />
      <geometry>
        <cylinder radius="0.045" length="0.55" />
      </geometry>
    </collision>
  </link>

  <joint name="upperArm_joint" type="revolute">
    <origin xyz="0 0.191 0"
      rpy="-1.5707963267948966192313216916398 -1.5707963267948966192313216916398 0" />
    <parent link="shoulder_Link" />
    <child link="upperArm_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="267" start_stop="411"
      velocity="3.106686068549906" />
  </joint>

  <link name="foreArm_Link">
    <inertial>
      <origin xyz="0.269208 -0.000022 0.106467" rpy="0 0 0" />
      <mass value="3.926354" />
      <inertia ixx="0.006007" ixy="0.000009" ixz="0.001991" iyy="0.083780" iyz="0.000005"
        izz="0.082433" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link3.DAE" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <!-- Forearm: cylinder 0.185-->
    <collision>
      <origin xyz="0.19 0. 0.12" rpy="0 1.5707963267948966192313216916398 0" />
      <geometry>
        <cylinder radius="0.035" length="0.370" />
      </geometry>
    </collision>
  </link>

  <joint name="foreArm_joint" type="revolute">
    <origin xyz="0.480 0 0" rpy="-3.1415926535897932384626433832795 -4.5954E-17 -8.4328E-17" />
    <parent link="upperArm_Link" />
    <child link="foreArm_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="133" start_stop="207"
      velocity="4.660029102824860" />
  </joint>

  <link name="wrist1_Link">
    <inertial>
      <origin xyz="0.000036 0.015610 -0.001526" rpy="0 0 0" />
      <mass value="2.370741" />
      <inertia ixx="0.003672" ixy="0.000006" ixz="-0.000001" iyy="0.002190" iyz="-0.000080"
        izz="0.003621" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link4.DAE" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <!-- Wrist1: small sphere -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist1_joint" type="revolute">
    <origin xyz="0.370 0 0"
      rpy="3.1415926535897932384626433832795 -1.4294E-15 1.5707963267948966192313216916398" />
    <parent link="foreArm_Link" />
    <child link="wrist1_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="49" start_stop="66"
      velocity="4.136430327226561" />
  </joint>

  <link name="wrist2_Link">
    <inertial>
      <origin xyz="-0.000036 -0.015610 -0.001526" rpy="0 0 0" />
      <mass value="2.370741" />
      <inertia ixx="0.003672" ixy="0.000006" ixz="0.000001" iyy="0.002190" iyz="0.000080"
        izz="0.003621" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link5.DAE" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <!-- Wrist2: small sphere -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist2_joint" type="revolute">
    <origin xyz="0 0.1175 0" rpy="-1.5707963267948966192313216916398 -7.0777E-16 -7.4101E-16" />
    <parent link="wrist1_Link" />
    <child link="wrist2_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="49" start_stop="66"
      velocity="4.136430327226561" />
  </joint>

  <link name="wrist3_Link">
    <inertial>
      <origin xyz="0.000508 0.000344 -0.017049" rpy="0 0 0" />
      <mass value="0.259654" />
      <inertia ixx="0.000162" ixy="-0.000000" ixz="-0.000000" iyy="0.000160" iyz="0.000001"
        izz="0.000273" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://seer_description/meshes/aubo_i16H/visual/link6.DAE" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <!-- Wrist3/TCP: tiny sphere -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.035" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist3_joint" type="revolute">
    <origin xyz="0 -0.1035 0" rpy="1.5707963267948966192313216916398 0 6.7283E-16" />
    <parent link="wrist2_Link" />
    <child link="wrist3_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="49" start_stop="66"
      velocity="4.136430327226561" />
  </joint>

  <!-- using world if you only use this urdf alone, but when included in
  composite_robot_stick.xacro, the world link and joint are defined there, so we comment them out
  here to avoid duplication. -->
  <!-- <link name="world" />

  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint> -->

</robot>