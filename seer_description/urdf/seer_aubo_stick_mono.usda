#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./seer_aubo_stick.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "seer_aubo_composite"
    {
        over "joints"
        {
            over "camera_joint" (
                active = false
            )
            {
            }

            over "camera_color_screw_joint" (
                active = false
            )
            {
            }

            over "camera_depth_joint" (
                active = false
            )
            {
            }

            over "camera_IMU_joint" (
                active = false
            )
            {
            }

            over "camera_color_joint" (
                active = false
            )
            {
            }

            over "camera_color_optical_joint" (
                active = false
            )
            {
            }

            over "camera_left_ir_joint" (
                active = false
            )
            {
            }

            over "camera_left_ir_optical_joint" (
                active = false
            )
            {
            }

            over "camera_right_ir_joint" (
                active = false
            )
            {
            }

            over "camera_right_ir_optical_joint" (
                active = false
            )
            {
            }

            def PhysicsFixedJoint "mono_camera_joint"
            {
                rel physics:body0 = </World/seer_aubo_composite/gripper_motor_link>
                rel physics:body1 = </World/seer_aubo_composite/mono_camera_link>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, 0.1, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "camera_link" (
            active = false
        )
        {
        }

        over "camera_color_screw_frame" (
            active = false
        )
        {
        }

        over "camera_depth_frame" (
            active = false
        )
        {
        }

        over "camera_IMU_frame" (
            active = false
        )
        {
        }

        over "camera_color_frame" (
            active = false
        )
        {
        }

        over "camera_color_optical_frame" (
            active = false
        )
        {
        }

        over "camera_left_ir_frame" (
            active = false
        )
        {
        }

        over "camera_left_ir_optical_frame" (
            active = false
        )
        {
        }

        over "camera_right_ir_frame" (
            active = false
        )
        {
        }

        over "camera_right_ir_optical_frame" (
            active = false
        )
        {
        }

        def Xform "mono_camera_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, -0.011)
            float3 physics:diagonalInertia = (0.00014, 0.00013, 0.00004)
            float physics:mass = 0.193
            quatf xformOp:orient = (-0.70710677, 0.70710677, 4.3297803e-17, -1.4348013e-8)
            double3 xformOp:translate = (-0.300000129101103, 0.2944999933242798, 1.8304998636245728)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "body" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.16, 0.18, 0.21)]
                double size = 1
                float3 xformOp:scale = (0.029, 0.044, 0.059)
                double3 xformOp:translate = (0, 0, -0.0295)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cylinder "lens_12mm" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.04
                color3f[] primvars:displayColor = [(0.035, 0.035, 0.035)]
                double radius = 0.0175
                double3 xformOp:translate = (0, 0, 0.02)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Xform "camera_optical_frame"
            {
                double3 xformOp:translate = (0, 0, 0.04)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Camera "ros2_camera"
                {
                    float2 clippingRange = (0.01, 100)
                    float focalLength = 12
                    float horizontalAperture = 14.1312
                    custom string sensor:model = "MV-CH100-60UM"
                    custom int2 sensor:nativeResolution = (4096, 2460)
                    custom string sensor:pixelFormat = "mono8"
                    float verticalAperture = 8.487
                    float3 xformOp:rotateXYZ = (180, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
                }
            }
        }
    }
}
