<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Alternative two-finger gripper made from the user-supplied millimetre STL files.
    Joint names intentionally match the existing stick gripper. This Blender-centred
    geometry uses 0=open / 0.0285=closed to retain clearance between collision boxes.
  -->
  <xacro:macro name="finger_motor_adapter_gripper" params="parent *origin">
    <link name="gripper_adapter_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="adapter_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_adapter_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="gripper_motor_link">
      <visual>
        <!-- Blender-adjusted metre mesh; rotate its negative Z extent away from the wrist. -->
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
        <geometry>
          <mesh filename="package://seer_description/meshes/motor_new.stl" scale="1 1 1"/>
        </geometry>
        <material name="new_gripper_dark">
          <color rgba="0.16 0.18 0.21 1"/>
        </material>
      </visual>
      <!-- Conservative primitive avoids a 42k-face planning/physics collider. -->
      <collision>
        <!-- Axis-aligned bounds after the visual's 180 degree X rotation. -->
        <origin xyz="0.021777213 -0.000106815 0.067125965" rpy="0 0 0"/>
        <geometry><box size="0.1985 0.063 0.137"/></geometry>
      </collision>
      <inertial>
        <!-- Temporary 1.2 kg bounding-box estimate; replace after weighing the assembly. -->
        <origin xyz="0.021777213 -0.000106815 0.067125965"/>
        <mass value="1.2"/>
        <inertia ixx="0.0022738" ixy="0" ixz="0" iyy="0.005817125" iyz="0" izz="0.004337125"/>
      </inertial>
    </link>

    <joint name="motor_mount_joint" type="fixed">
      <parent link="gripper_adapter_link"/>
      <child link="gripper_motor_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="gripper1_link">
      <visual>
        <!-- Blender-adjusted metre mesh; rotate its 150 mm length onto link Y. -->
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://seer_description/meshes/finger_centered.stl" scale="1 1 1"/>
        </geometry>
        <material name="new_gripper_finger"><color rgba="0.76 0.78 0.82 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.003100952 0.000095278 0.024519681"/>
        <geometry><box size="0.049 0.15 0.047786"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.003100952 0.000095278 0.024519681"/>
        <mass value="0.18"/>
        <inertia ixx="0.000371752" ixy="0" ixz="0" iyy="0.000070267" iyz="0" izz="0.000373515"/>
      </inertial>
    </link>

    <link name="gripper2_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${pi}"/>
        <geometry>
          <mesh filename="package://seer_description/meshes/finger_centered.stl" scale="1 1 1"/>
        </geometry>
        <material name="new_gripper_finger"/>
      </visual>
      <collision>
        <origin xyz="-0.003100952 -0.000095278 0.024519681"/>
        <geometry><box size="0.049 0.15 0.047786"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.003100952 -0.000095278 0.024519681"/>
        <mass value="0.18"/>
        <inertia ixx="0.000371752" ixy="0" ixz="0" iyy="0.000070267" iyz="0" izz="0.000373515"/>
      </inertial>
    </link>

    <!-- Blender-adjusted joint centres are 112.8 mm apart at q=0. -->
    <joint name="gripper1_joint" type="prismatic">
      <parent link="gripper_motor_link"/>
      <child link="gripper1_link"/>
      <origin xyz="-0.0564 0 0.135" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.0285" effort="50" velocity="0.1"/>
    </joint>

    <joint name="gripper2_joint" type="prismatic">
      <parent link="gripper_motor_link"/>
      <child link="gripper2_link"/>
      <origin xyz="0.0564 0 0.135" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0" upper="0.0285" effort="50" velocity="0.1"/>
    </joint>
  </xacro:macro>
</robot>
