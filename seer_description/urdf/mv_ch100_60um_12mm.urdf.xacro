<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mv_ch100_60um">
  <!-- Body dimensions/mass from datasheet. Lens envelope and mass are estimates. -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 -0.011"/>
      <mass value="0.193"/>
      <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0295"/>
      <geometry><box size="0.029 0.044 0.059"/></geometry>
      <material name="hikrobot_body"><color rgba="0.16 0.18 0.21 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0295"/>
      <geometry><box size="0.029 0.044 0.059"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.0175" length="0.04"/></geometry>
      <material name="c_mount_lens"><color rgba="0.035 0.035 0.035 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.0175" length="0.04"/></geometry>
    </collision>
  </link>
  <!-- Ideal pinhole at approximate front of the unspecified 12 mm lens. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>
  <gazebo reference="camera_optical_frame">
    <sensor name="mv_ch100_60um" type="camera">
      <!-- Gazebo +X-forward camera to ROS +Z-forward optical convention. -->
      <pose>0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>
      <always_on>true</always_on><update_rate>36</update_rate>
      <topic>/camera/image_raw</topic><gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>${2 * atan(4096 * 0.00345 / (2 * 12))}</horizontal_fov>
        <image><width>4096</width><height>2460</height><format>L8</format></image>
        <clip><near>0.01</near><far>100</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
