        <joint name="wrist1_joint" value="0.5901" />
        <joint name="wrist2_joint" value="1.57" />
        <joint name="wrist3_joint" value="0.3818" />
    </group_state>
    <group_state name="pick_closed" group="manipulator">
        <joint name="foreArm_joint" value="2.2564" />
        <joint name="gripper1_joint" value="0.04" />
        <joint name="gripper2_joint" value="0.04" />
        <joint name="shoulder_joint" value="-2.7423" />
        <joint name="upperArm_joint" value="0.1041" />
        <joint name="wrist1_joint" value="0.5901" />
        <joint name="wrist2_joint" value="1.57" />
        <joint name="wrist3_joint" value="0.3818" />
    </group_state>
    <group_state name="place_open" group="manipulator">
        <joint name="foreArm_joint" value="-0.1041" />
        <joint name="gripper1_joint" value="0" />
        <joint name="gripper2_joint" value="0" />
        <joint name="shoulder_joint" value="-3.1589" />
        <joint name="upperArm_joint" value="0.3124" />
        <joint name="wrist1_joint" value="-0.4513" />
        <joint name="wrist2_joint" value="-1.6315" />
        <joint name="wrist3_joint" value="0" />
    </group_state>
    <group_state name="place_closed" group="manipulator">
        <joint name="foreArm_joint" value="-0.1041" />
        <joint name="gripper1_joint" value="0.04" />
        <joint name="gripper2_joint" value="0.04" />
        <joint name="shoulder_joint" value="-3.1589" />
        <joint name="upperArm_joint" value="0.3124" />
        <joint name="wrist1_joint" value="-0.4513" />
        <joint name="wrist2_joint" value="-1.6315" />
        <joint name="wrist3_joint" value="0" />
    </group_state>
    <end_effector name="stick_gripper" parent_link="gripper_adapter_link" group="gripper" parent_group="manipulator" />
    <disable_collisions link1="aubo_base_link" link2="back_lidar_link" reason="Never" />
