Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_footprint
    Background Color: 30; 35; 45
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Name: TARGET POSE ONLY - not the live robot
      Enabled: true
      Topic:
        Value: /diagnostics/student_target
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.65
      Pitch: 0.35
      Yaw: 1.1
      Target Frame: base_footprint
  Value: true
Window Geometry:
  Width: 1280
  Height: 900
